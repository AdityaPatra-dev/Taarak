rules_version = '2';

// Mirrors lib/app/route_guard.dart's defaultRoutePermissions: a collection
// is only writable by the roles whose permission actually covers that
// action in the app itself, so these rules can't drift silently out of
// sync with what the UI already gates.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && role() in roles;
    }

    // Each user's own profile (name, email, role). Role is set once at
    // registration — always 'citizen', enforced below — and is never
    // self-editable by the user themselves. Permission.manageAccounts
    // (System Admin only) can read every profile and change anyone's role
    // via the in-app account management screen. District/Command can also
    // read the full list — needed to pick a Field Responder to assign an
    // incident to — but not write anyone else's role.
    match /users/{uid} {
      allow read: if isSignedIn()
                  && (request.auth.uid == uid
                      || hasAnyRole(['systemAdmin', 'districtCommand']));
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'citizen';
      allow update: if isSignedIn() && (
                      (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role)
                      || hasAnyRole(['systemAdmin'])
                    );
      allow delete: if false;
    }

    // Permission.submitIncidentReport: any signed-in citizen can file one.
    // Reads stay open to any signed-in user — SyncCoordinatorService pulls
    // this collection into every device's local cache unconditionally, not
    // just officials', so a read restriction here would break sync for
    // citizen devices even though the /verification *screen* is already
    // gated to Permission.verifyReports client-side. Only updating a
    // report (e.g. linking it to a verified incident) is official-only.
    match /local_incident_reports/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if hasAnyRole(['localOfficial', 'districtCommand']);
      allow delete: if false;
    }

    // Confirmed incidents (post ground-truth fusion). Written by the same
    // roles that can verify/transition them; readable by anyone signed in
    // so the risk map and dashboard can render them. systemAdmin's delete
    // access is Permission.moderateContent — a real removal (see
    // ContentModerationService), never a verification-lifecycle transition,
    // which stays official/command-only and update-only.
    match /local_incidents/{id} {
      allow read: if isSignedIn();
      allow create, update: if hasAnyRole(['localOfficial', 'districtCommand']);
      allow delete: if hasAnyRole(['systemAdmin']);
    }

    // Permission.viewRiskMap is a citizen permission, so reads stay open
    // to anyone signed in; writes are restricted to the official roles
    // that ingest hazard data. systemAdmin's delete access is
    // Permission.moderateContent (see ContentModerationService).
    match /local_hazard_zones/{id} {
      allow read: if isSignedIn();
      allow create, update: if hasAnyRole(
        ['localOfficial', 'districtCommand', 'stateAdmin']
      );
      allow delete: if hasAnyRole(['systemAdmin']);
    }

    // Permission.viewSheltersRoutes (citizen, read) vs.
    // Permission.manageSheltersResources (Local Official only, write).
    // Unlike incidents/hazard_zones/alerts, a shelter's delete is the same
    // Local Official manage capability as its create/update, not a
    // systemAdmin-only moderation action — so it shares their allowlist.
    match /local_shelters/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasAnyRole(['localOfficial']);
    }

    // Permission.viewAlerts (citizen, read) vs. Permission.sendBroadcast
    // (Local Official only, write/cancel). systemAdmin's delete access is
    // Permission.moderateContent — a real removal (see
    // ContentModerationService), distinct from a Local Official cancelling
    // one (still an update, via AlertBroadcastService.cancelAlert).
    match /local_alerts/{id} {
      allow read: if isSignedIn();
      allow create, update: if hasAnyRole(['localOfficial']);
      allow delete: if hasAnyRole(['systemAdmin']);
    }

    // A Field Responder's on-site damage assessment for an incident
    // they're assigned to. Read stays open (District/Command and Local
    // Officials review these; the app doesn't restrict who can see one).
    match /local_damage_reports/{id} {
      allow read: if isSignedIn();
      allow create: if hasAnyRole(['fieldResponder']);
      allow update: if false;
      allow delete: if false;
    }

    // Permission.manageResources (District/Command only, write). Read
    // stays open, same reasoning as every other shared-state collection.
    match /local_resources/{id} {
      allow read: if isSignedIn();
      allow create, update: if hasAnyRole(['districtCommand']);
      allow delete: if false;
    }

    // Vulnerable habitations (M08/M09/M10's subject) — the same official
    // roles that report hazard zones register these; read stays open since
    // the risk map, command dashboard, and relocation priority queue all
    // need them regardless of the viewer's own role.
    match /local_habitations/{id} {
      allow read: if isSignedIn();
      allow create, update: if hasAnyRole(
        ['localOfficial', 'districtCommand', 'stateAdmin']
      );
      allow delete: if false;
    }

    // Permission.managePolicyConfiguration (State/Admin only, write) —
    // read stays open since broadcast_alert_screen.dart and
    // report_hazard_zone_screen.dart read this regardless of the
    // viewer's own role.
    match /config/policy {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['stateAdmin']);
    }

    // Permission.managePermissions / Permission.manageTechnicalConfiguration
    // (System Admin only, write) — read stays open the same way
    // config/policy's does: the route guard and home screen resolve every
    // signed-in user's effective permissions against this doc regardless
    // of their own role, and the sync polling trigger reads the interval
    // the same way for every device.
    match /config/role_permissions {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['systemAdmin']);
    }

    match /config/technical {
      allow read: if isSignedIn();
      allow write: if hasAnyRole(['systemAdmin']);
    }
  }
}
